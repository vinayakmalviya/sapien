{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://REPLACE-WITH-YOUR-BACKEND-HOST/:path*"
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
